@startuml
title Escola de Idiomas — Etapa I
skinparam classAttributeIconSize 0

package "dados.enums" {
  enum NivelCurso {
    BASICO
    INTERMEDIARIO
    AVANCADO
  }

  enum SituacaoTurma {
    ABERTA
    EM_ANDAMENTO
    CONCLUIDA
  }

  enum TipoAvaliacao {
    PROVA
    TRABALHO
    EXERCICIO
  }
}

package "dados" {
  class Aluno {
    - nome: String
    - cpf: String
    - email: String
  }

  class Professor {
    - nome: String
    - cpf: String
    - email: String
  }

  class Curso {
    - codigo: String
    - nome: String
    - idioma: String
    - nivel: NivelCurso
    - modulos: List<Modulo>
    + adicionarModulo(modulo: Modulo): void
    + buscarModulo(numero: int): Modulo
  }

  class Modulo {
    - numero: int
    - nome: String
    - cargaHoraria: int
  }

  class Turma {
    - codigo: String
    - curso: Curso
    - professor: Professor
    - quantidadeMaximaAlunos: int
    - situacao: SituacaoTurma
    + abrir(): void
    + encerrar(): void
  }

  class Matricula {
    - aluno: Aluno
    - turma: Turma
    - mensalidade: double
    - ativa: boolean
  }

  class Avaliacao {
    - descricao: String
    - valor: double
    - modulo: Modulo
    - tipo: TipoAvaliacao
  }

  class Nota {
    - aluno: Aluno
    - avaliacao: Avaliacao
    - nota: double
  }

  class Mensalidade {
    - numero: int
    - valor: double
    - paga: boolean
  }

  class Pagamento {
    - valor: double
    - formaPagamento: String
  }

  class Encontro {
    - numero: int
    - modulo: Modulo
    - data: String
  }

  Curso "1" *-- "*" Modulo
  Curso "1" -- "*" Turma
  Professor "1" -- "*" Turma
  Aluno "1" -- "*" Matricula
  Turma "1" -- "*" Matricula
  Modulo "1" -- "*" Avaliacao
  Aluno "1" -- "*" Nota
  Avaliacao "1" -- "*" Nota
  Matricula "1" -- "*" Mensalidade
  Mensalidade "1" -- "0..1" Pagamento
  Modulo "1" -- "*" Encontro
  Curso --> NivelCurso
  Turma --> SituacaoTurma
  Avaliacao --> TipoAvaliacao
}

package "negocio" {
  class Sistema {
    - alunos: List<Aluno>
    - professores: List<Professor>
    - cursos: List<Curso>
    - turmas: List<Turma>
    - matriculas: List<Matricula>
    - avaliacoes: List<Avaliacao>
    - notas: List<Nota>
    - mensalidades: List<Mensalidade>
    - pagamentos: List<Pagamento>
    - encontros: List<Encontro>
    + cadastrarAluno(aluno: Aluno): void
    + cadastrarProfessor(professor: Professor): void
    + cadastrarCurso(curso: Curso): void
    + cadastrarTurma(turma: Turma): void
    + cadastrarMatricula(matricula: Matricula): void
    + cadastrarAvaliacao(avaliacao: Avaliacao): void
    + cadastrarNota(nota: Nota): void
    + cadastrarMensalidade(mensalidade: Mensalidade): void
    + cadastrarPagamento(mensalidade: Mensalidade, pagamento: Pagamento): void
    + cadastrarEncontro(encontro: Encontro): void
    + buscarAluno(cpf: String): Aluno
    + buscarProfessor(cpf: String): Professor
    + buscarCurso(codigo: String): Curso
    + buscarTurma(codigo: String): Turma
    + buscarMatricula(cpfAluno: String, codigoTurma: String): Matricula
    + buscarAvaliacao(descricao: String): Avaliacao
    + buscarMensalidade(numero: int): Mensalidade
  }

  class Programa {
    + main(args: String[]): void
  }

  class RegraNegocioException {
  }

  Sistema "1" o-- "*" Aluno
  Sistema "1" o-- "*" Professor
  Sistema "1" o-- "*" Curso
  Sistema "1" o-- "*" Turma
  Sistema "1" o-- "*" Matricula
  Sistema "1" o-- "*" Avaliacao
  Sistema "1" o-- "*" Nota
  Sistema "1" o-- "*" Mensalidade
  Sistema "1" o-- "*" Pagamento
  Sistema "1" o-- "*" Encontro
  Programa ..> Sistema : menu no terminal
}

note bottom of Programa
  Programa interativo com Scanner.
  O sistema começa vazio.
  O usuário cadastra e relaciona os objetos pelo menu.
end note

@enduml
